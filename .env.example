# Django Settings
DEBUG=False
SECRET_KEY=django-insecure-change-this-in-production
ALLOWED_HOSTS=*

# Database - TimescaleDB
DB_NAME=meteodb
DB_USER=infoclimat
DB_PASSWORD=infoclimat2026
DB_HOST=timescaledb
DB_PORT=5432

# CORS - Frontend origins (Vite default port)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO

# Frontend
NUXT_PUBLIC_API_BASE=http://localhost/api/v1

# Donnees simulees : les CSV du seed ne sont pas versionnes (cf backend/README.md)
MOCKED_DATA=true

# Images publiees par la CI sur GHCR (docker-compose.test.yml)
# IMAGE_TAG peut etre un SHA de commit pour rejouer une version precise
REGISTRY_IMAGE=ghcr.io/lucasratiaray/14_valorisationdonneemeteo
IMAGE_TAG=latest
